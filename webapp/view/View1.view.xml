<mvc:View controllerName="pluspe.z9451controlhes.controller.View1"
   height="100%"
	xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
	xmlns="sap.m"
	xmlns:layout="sap.ui.layout"
	xmlns:semantic="sap.f.semantic"
	>

	<semantic:SemanticPage
		id="mySemanticPage"
		headerPinnable="true"
		toggleHeaderOnTitleClick="true"
		preserveHeaderStateOnScroll="false"
		titleAreaShrinkRatio="1:1.6:1.6"
		showFooter="{/showFooter}">

		<!-- Header Content -->
		<semantic:headerContent>
        <Title text="Datos Basicos HES" class="sapUiTinyMarginBeginEnd sapUiTinyMarginTop"/>
	<HBox
    justifyContent="Start"
    alignItems="Center"
    wrap="Wrap"
    class="sapUiTinyMarginTop sapUiTinyMarginBottom sapUiTinyMarginBeginEnd">

    <!-- Usuario -->

<VBox class="sapUiTinyMarginEnd" width="10rem">
    <Label text="Usuario"/>
    <Input 
        id="inputUsuario"
        placeholder="Ingrese usuario"
        value="{detalleModel>/usuario}"
        showValueHelp="true"
        valueHelpRequest=".onValueHelpUsuario"
        width="100%"
    />
</VBox>

    <!-- Ubicación -->
    <VBox class="sapUiTinyMarginEnd" width="10rem">
        <Label text="Ubicación"/>
        <Input id="inputUbicacion" placeholder="Ingrese ubicación" value="{detalleModel>/ubicacion}" width="100%"/>
    </VBox>

    <!-- Texto -->
    <VBox class="sapUiTinyMarginEnd" width="10rem">
        <Label text="Texto"/>
        <Input id="inputTexto" placeholder="Ingrese texto" value="{detalleModel>/texto}" width="100%"/>
    </VBox>

    <!-- Desde -->
    <VBox class="sapUiTinyMarginEnd" width="10rem">
        <Label text="Desde"/>
        <DatePicker id="inputDesde" placeholder="Fecha desde" value="{detalleModel>/desde}"  valueFormat="yyyyMMdd"  displayFormat="dd/MM/yyyy" width="100%"/>
    </VBox>

    <!-- Hasta -->
    <VBox class="sapUiTinyMarginEnd" width="10rem">
        <Label text="Hasta"/>
        <DatePicker id="inputHasta" change=".onFechaHastaChange" placeholder="Fecha hasta" value="{detalleModel>/hasta}"  valueFormat="yyyyMMdd"  displayFormat="dd/MM/yyyy" width="100%"/>
    </VBox>

    <!-- Orden -->
    <VBox class="sapUiTinyMarginEnd" width="13rem">
        <Label text="Orden de compra Planificada" class="negrita"/>
        <Input id="inputOrden"
            placeholder="Ingrese orden"
            value="{
                path : '/Orden',
                type : 'sap.ui.model.odata.type.String',
                constraints : {
                    minLength: 10,
                    maxLength: 10
                }
            }"
            change=".onNameChange"
            width="100%" />
    </VBox>

    <!-- Botón GO -->
    <VBox width="6rem">
        <Label text=" "/>
        <Button text="GO" press="onGoPress" type="Emphasized" class="sapUiTinyMarginBeginEnd" width="100%"/>
    </VBox>
</HBox>
		</semantic:headerContent>

		<!-- Content -->
		<semantic:content>
			<layout:VerticalLayout>
				<Panel headerText="Orden de compra Planificada" expandable="true" expanded="true" class="sapUiSmallMargin">
					<Table
						id="idProductsTable"
						inset="false"
						items="{OrdenModel>/Ordenes}"
						class="sapFSemanticPageAlignContent"
						width="auto"
						
						>

						<columns >
							<Column><Text text="Orden"/></Column>
							<Column><Text text="OrdenPosicion"/></Column>
							<Column><Text text="Descripcion"/></Column>
							<Column><Text text="TipoOrdCompra"/></Column>
							<Column><Text text="CatAsig"/></Column>
                              
						</columns>

						<items>
							<ColumnListItem vAlign="Middle" type="Navigation" press="onItemPress">
								<cells>
									<Text text="{OrdenModel>Orden}"/>
									<Text text="{OrdenModel>OrdenPosicion}"/>
									<Text text="{OrdenModel>Descripcion}"/>
									<Text text="{OrdenModel>TipoOrdCompra}"/>
									<Text text="{OrdenModel>CatAsig}"/>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</Panel>

<Panel 
    id="myPanel"
    headerText="{= 'Orden de compra Panificada' + ${OrdenModel>/Contrato}}" 
    expandable="true" 
    expanded="false" 
    class="sapUiSmallMargin">
    <headerToolbar>
        <Toolbar>
            <Title text="{= 'Acuerdo Marco - Contrato :  ' + ${OrdenModel>/Contrato}}" visible="{= !!${OrdenModel>/Contrato}}" />
            <ToolbarSpacer/>
            <Button 
                id="toggleButton" 
                type="Emphasized"
                text="Agregar pos de Contrato" 
                press="onTogglePanel"/>
			    <Button 
                visible="true"
                id="toggleButton2" 
                type="Default"
                text="Continuar proceso de certificación" 
				enabled="false"
                press="ContinuarProceso"/>	
        </Toolbar>
    </headerToolbar>

    <!-- Tabla para mostrar los detalles del contrato -->
<Table
    id="contratoTable"
    items="{contratoModel>/ContratoDetalle}"
    class="sapUiResponsiveMargin"
    inset="false"
    width="auto">

    <columns>
        <Column width="6rem"><Text text="Posición" /></Column>
        <Column width="10rem"><Text text="Descripción" /></Column>
        <Column><Text text="Num Servicio" /></Column>
        <Column width="12rem"><Text text="Des Servicio" /></Column>
        <Column><Text text="Cantidad" /></Column>
        <Column><Text text="Usado" /></Column>
        <Column><Text text="Restante" /></Column>
        <Column><Text text="Importe Nuevo" visible="false"/></Column>
        <Column id="colAccion" visible="false"><Text text="Accion" /></Column>
    </columns>

    <items>
        <ColumnListItem type="Inactive" class="{contratoModel>ColorClase}"> 
            <customData>
                <core:CustomData key="colorClase" value="{contratoModel>ColorClase}" writeToDom="true"/>
            </customData>

            <cells>
                <!-- Cuenta Mayor -->
                <VBox id="idCuentaMayorBox">
                    <Text id="idOrdenPosicionText" 
                          text="{contratoModel>OrdenPosicion}"
                          visible="{= ${contratoModel>EsOriginal} === true }" />
                    <Input 
                        id="idCuentaMayorInput"
                        visible="{= !${contratoModel>EsOriginal} }"
                        class="inputBelowText"  
                        placeholder="Cuenta Mayor" 
                        value="{path: 'contratoModel>CuentaMayor', mode: 'TwoWay'}"
                        showValueHelp="true"
                        liveChange=".onImputacionChange"
                        valueHelpRequest=".onValueHelpCuentaMayor"
                        width="100%" />
                </VBox>

                <!-- Centro de Coste -->
                <VBox id="idCentroCosteBox">
                    <Text id="idDescripcionContratoText" 
                          text="{contratoModel>DescripcionContrato}" 
                          visible="{= ${contratoModel>EsOriginal} === true }"/>
                    <Input 
                        id="idCentroCosteInput"  
                        visible="{= !${contratoModel>EsOriginal} }"
                        placeholder="Centro de Coste" 
                        class="inputBelowText" 
                        width="100%" 
                        value="{path: 'contratoModel>CentroCoste', mode: 'TwoWay'}"
                        liveChange=".onCentroCosteChange"
                        change=".onCentroCosteChange"
                        showValueHelp="true"
                        valueHelpRequest=".onValueHelpCentroCoste"/>
                </VBox>

                <!-- Orden -->
                <VBox id="idOrdenBox">
                    <Text id="idNroServicioText" 
                          text="{contratoModel>NroServicio}"
                          visible="{= ${contratoModel>EsOriginal} === true }" />
                    <Input 
                        id="idOrdenInput" 
                        visible="{= !${contratoModel>EsOriginal} }"
                        placeholder="Orden" 
                        class="inputBelowText"  
                        width="100%" 
                        value="{path: 'contratoModel>Orden', mode: 'TwoWay'}"
                        liveChange=".onOrdenChange"
                        change=".onOrdenChange"/>
                </VBox>

                <!-- Cant/Porc -->
                <VBox id="idCanPorcBox">
                    <Text id="idDescripcionText" 
                          text="{contratoModel>Descripcion}"
                          visible="{= ${contratoModel>EsOriginal} === true }" />
                    <Input 
                        id="idCanPorcInput" 
                        visible="{= !${contratoModel>EsOriginal} }"
                        placeholder="Cant/Porc"
                        value="{path: 'contratoModel>CantPorc', mode: 'TwoWay'}"
                        width="100%" 
                        liveChange=".onImputacionChange"/>
                </VBox>

                <!-- Tipo Imputacion -->
                <VBox id="idTipoImputacionBox">
                    <Text id="idCantidadText"
                          text="{contratoModel>Cantidad}"
                          visible="{= ${contratoModel>EsOriginal} === true }" />
                    <Input 
                        id="idTipoImputacionInput"
                        visible="{= !${contratoModel>EsOriginal} }"
                        placeholder="Tipo Imputación" 
                        class="inputBelowText" 
                        width="100%"
                        value="{path: 'contratoModel>TipoImputacion', mode: 'TwoWay'}"
                        showValueHelp="true"
                        liveChange=".onImputacionChange"
                        valueHelpRequest=".onValueHelpTipoImputacion" />
                </VBox>

                <!-- Ind Distribucion -->
                <VBox id="idDistribucionBox">
                    <Text id="idUsadoText"
                          text="{contratoModel>Usado}"
                          visible="{= ${contratoModel>EsOriginal} === true }" />
                    <Input 
                        id="idIndDistribucionInput"  
                        visible="{= !${contratoModel>EsOriginal} }"
                        placeholder="Ind. Distribución" 
                        class="inputBelowText" 
                        value="{path: 'contratoModel>IndDistribucion', mode: 'TwoWay'}"
                        showValueHelp="true"
                        liveChange=".onImputacionChange"
                        valueHelpRequest=".onValueHelpDistribucion"
                        width="100%" />
                </VBox>

                <!-- Restante -->
                <VBox>
                    <Text text="{contratoModel>Restante}" 
                    visible="{= ${contratoModel>EsOriginal} }" />
                    <Input 
                        id="idProyectosInput"
                        visible="{= !${contratoModel>EsOriginal} }"
                        placeholder="Proyecto"
                        class="inputBelowText"
                        value="{path: 'contratoModel>Proyectos', mode: 'TwoWay'}"
                        showValueHelp="true"
                        liveChange=".onImputacionChange"
                        valueHelpRequest=".onValueHelpProyecto"
                        width="100%" />

                   </VBox>

                <!-- Importe Nuevo -->
                <VBox>
                    <Input
                        visible="{= ${contratoModel>EsOriginal} }"
                        id="idImporteNuevoInput"
                        value="{path: 'contratoModel>ImporteNuevo', mode: 'TwoWay'}"
                        liveChange=".onInputChange"
                        placeholder="Nuevo Importe"
                        width="100%" />
                </VBox>

                <!-- Botones -->
                <HBox>
                    <Button
                        id="idAccionButton"
                        visible="false"
                        icon="sap-icon://add"
                        type="Neutral"
                        width="0.5rem"
                        press="onAccionPress" />

                    <Button
                        id="idAccionButton2"
                        visible="false"
                        icon="sap-icon://less"
                        type="Neutral"
                        width="0.5rem"
                        press=".onAccionPress2" />
                </HBox> 
            </cells>
        </ColumnListItem>
    </items>
</Table>
</Panel>

			</layout:VerticalLayout>
		</semantic:content>
		

	</semantic:SemanticPage>
</mvc:View>
