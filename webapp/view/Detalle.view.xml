<mvc:View
    controllerName="pluspe.z9451controlhes.controller.Detalle"
    xmlns:mvc="sap.ui.core.mvc"
     xmlns:core="sap.ui.core"
    xmlns="sap.m"
    height="100%">

    <Page id="mainPage" title="Orden: {detalleModel>/orden}">

 

        <content>
            <Table
                id="idDetalleTable"
                items="{itemsModel>/items}">

                <columns>
                    <Column><Text text="Contrato"/></Column>
                    <Column><Text text="Orden Compra"/></Column>
                    <Column width="8rem"><Text text="Posición OC"/></Column>                                
                    <Column width="8rem"><Text text="Cod.Servicio"/></Column>
                    <Column width="8rem"><Text text="Descripcion"/></Column>
                    <Column width="5rem"><Text text="Cantidad Solicitada"/></Column>
                    <Column width="8rem"><Text text="Cantidad Certificada"/></Column>
                    <Column width="8rem"><Text text="Cantidad sin Ejecutar"/></Column>
                    <Column ><Text text="Cert.Total Pos"/></Column>
                    <Column width="7rem"><Text text="Cantidad a Certificar"/></Column>
                     <Column id="colAccion2" visible="{detalleModel>/mostrarAccion}"><Text text="Accion" /></Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            
                            <Text text="{itemsModel>Contrato}"/>
                            <Text text="{itemsModel>Orden}"/>
                            

                                <!-- Cuenta Mayor -->
                            <VBox id="idCuentaMayorBox">
                            <Text text="{itemsModel>OrdenPosicion}"/>
                             <Input 
                                 class="sapUiLargeMarginTop"  
                                visible="{itemsModel>MostrarInputs}"  
                               
                                placeholder="Cuenta Mayor" 
                                value="{path: 'itemsModel>CuentaMayor', mode: 'TwoWay'}"
                                showValueHelp="true"
                                liveChange=".onImputacionChange"
                                valueHelpRequest=".onValueHelpCuentaMayor"
                                width="100%" />
                            </VBox>

                             <!-- Centro de Coste -->
                            <VBox id="idCentroCosteBox">
                            <Text text="{itemsModel>Servicio}"/>
                             <Input 
                               
                                 visible="{itemsModel>MostrarInputs}"  
                                placeholder="Centro de Coste" 
                                 class="sapUiLargeMarginTop"  
                                width="100%"                               
                                 value="{path: 'itemsModel>CentroCoste', mode: 'TwoWay'}"
                                liveChange=".onCentroCosteChange"
                                change=".onCentroCosteChange"
                                showValueHelp="true"
                                valueHelpRequest=".onValueHelpCentroCoste"/>
                                </VBox>


                            <!-- Orden -->
                           <VBox id="idOrdenBox">
  <VBox>
    <Text 
      text="{= ${itemsModel>EsClon} ? '\u00A0' : ${itemsModel>NumeroPack} }" 
      class="ordenTextPlaceholder"
    />
  </VBox>
                <VBox id="idVBox">
                    <Input 
                    id="InOrden"
                    visible="{itemsModel>MostrarInputs}"  
                    placeholder="Orden"                            
                    class="inputBelowText sapUiMediumMarginTop"  
                    width="100%"                           
                    value="{path: 'itemsModel>OrdenInput', mode: 'TwoWay'}"
                    liveChange=".onOrdenChange"
                    change=".onOrdenChange">
                    <customData>
                        <core:CustomData key="rowId" value="{itemsModel>ClonId}" />
                    </customData>
                    </Input>
                </VBox>
                </VBox>
                                            
                            <!-- Cant/Porc -->
                             <VBox id="idCanPorcBox">
                            <Text text="{itemsModel>Valor}"/>
                             <Input 
                                  class="sapUiLargeMarginTop"  
                                 visible="{itemsModel>MostrarInputs}"  
                                placeholder="Cant/Porc"                              
                                value="{path: 'itemsModel>CantPorc', mode: 'TwoWay'}"
                                width="100%" 
                                liveChange=".onImputacionChange"/>
                            </VBox>

                             
                             
                             <!-- Tipo Imputacion -->
                            <VBox id="idTipoImputacionBox">
                            <Text text="{itemsModel>Usado}"/>
                             <Input 
                                
                                visible="{= !${itemsModel>OcultarValueHelps} }" 
                                placeholder="Tipo Imputación" 
                               class="sapUiLargeMarginTop"  
                                width="100%"                      
                                 value="{path: 'itemsModel>TipoImputacion', mode: 'TwoWay'}"
                                showValueHelp="true"
                                liveChange=".onImputacionChange"
                                valueHelpRequest=".onValueHelpTipoImputacion" />
                                </VBox>


                            <!-- Ind Distribucion -->
                            <VBox id="idDistribucionBox">
                            <Text text="{itemsModel>Saldo}"/>
                            <Input 
                           
                            visible="{= !${itemsModel>OcultarValueHelps} }"
                            placeholder="Ind. Distribución" 
                            class="sapUiLargeMarginTop"                     
                             value="{path: 'itemsModel>IndDistribucion', mode: 'TwoWay'}"
                            showValueHelp="true"
                            liveChange=".onImputacionChange"
                            valueHelpRequest=".onValueHelpDistribucion"
                             width="100%" />
                            </VBox>


                             <VBox id="idContrato">
                            <CheckBox 
                                id="check1"
                                selected="{itemsModel>Totalizar}" 
                                select="onCheckboxSelect"
                                visible="{= !${itemsModel>EsClon} }"
                                />
                              
                        <Input 
                         id="idProyectosInput"
                       visible="{= !${itemsModel>OcultarValueHelps} }"
                        placeholder="Proyecto"
                        class="inputBelowText"
                        value="{path: 'itemsModel>Proyectos', mode: 'TwoWay'}"
                        showValueHelp="true"
                        liveChange=".onImputacionChange"
                        valueHelpRequest=".onValueHelpProyecto"
                        width="100%" />
                           </VBox>


                            
                            <Input 
                        visible="{= ${itemsModel>EsOriginal} }"
                        value="{itemsModel>ImporteNuevo}" 
                        placeholder="Importe"
                        enabled="{= !${itemsModel>Totalizar} }"
                        valueLiveUpdate="true"
                        liveChange=".onImporteNuevoChange"/>

                    <HBox visible="{= !${itemsModel>EsClon} }">
                       <Button
                        id="idAccionButtonDetalle"
                        visible="{detalleModel>/mostrarAccion}"
                        icon="sap-icon://add"
                        type="Neutral"
                        width="0.5rem"
                        press="onAccionDetallePress" />
                        
                    <Button
                        id="idAccionButton2Detalle"
                        visible="{= ${itemsModel>EsClon} }"
                        icon="sap-icon://less"
                        type="Neutral"
                        width="0.5rem"
                        press=".onAccionDetallePPress2" />
                </HBox> 
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

        <!-- Footer con botones -->
        <footer>
            <Toolbar>
                <ToolbarSpacer/>
                <Button id="BNFinal" text="Cancelar" type="Emphasized" press="onCancelPress"/>
                <Button text="Continuar proceso de certificación" type="Emphasized" press="onContinuePress"/>
            </Toolbar>
        </footer>
    </Page>
</mvc:View>